@startuml
' Título del diagrama
title "Diagrama Entidad-Relación - Registrar Nuevos Productos"

' Definición de entidades
entity "Producto" as producto {
    * id_producto : INTEGER [PK]
    --
    * nombre : VARCHAR(100)
    * descripcion : TEXT
    * unidad : VARCHAR(20)
    precio_compra : DECIMAL(10,2)
    precio_venta : DECIMAL(10,2)
    stock_minimo : INTEGER
    stock_maximo : INTEGER
    estado : VARCHAR(20)
    fecha_creacion : DATETIME
    fecha_actualizacion : DATETIME
}

entity "Proveedor" as proveedor {
    * id_proveedor : INTEGER [PK]
    --
    * nombre : VARCHAR(100)
    * ruc : VARCHAR(15)
    telefono : VARCHAR(20)
    email : VARCHAR(100)
    direccion : TEXT
    estado : VARCHAR(20)
}

entity "Categoria" as categoria {
    * id_categoria : INTEGER [PK]
    --
    * nombre : VARCHAR(50)
    descripcion : TEXT
    estado : VARCHAR(20)
}

entity "Usuario" as usuario {
    * id_usuario : INTEGER [PK]
    --
    * nombre : VARCHAR(100)
    * email : VARCHAR(100)
    * rol : VARCHAR(30)
    password : VARCHAR(255)
    estado : VARCHAR(20)
}

entity "Bitacora" as bitacora {
    * id_bitacora : INTEGER [PK]
    --
    * id_usuario : INTEGER [FK]
    * id_producto : INTEGER [FK]
    * accion : VARCHAR(50)
    * fecha : DATETIME
    detalles : TEXT
}

entity "HistoricoPrecio" as historico_precio {
    * id_historico : INTEGER [PK]
    --
    * id_producto : INTEGER [FK]
    * precio_anterior : DECIMAL(10,2)
    * precio_nuevo : DECIMAL(10,2)
    * fecha_cambio : DATETIME
    * id_usuario : INTEGER [FK]
}

' Definición de relaciones
producto }o--|| proveedor : "pertenece a"
producto }o--|| categoria : "clasificado en"
producto ||--o{ historico_precio : "tiene"
usuario ||--o{ bitacora : "registra"
producto ||--o{ bitacora : "es registrado por"

@enduml